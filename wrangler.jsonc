{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "language-learning-with-tv-shows",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./site"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tv.alanzhu.dev",
      "custom_domain": true
    }
  ]
}
